# Worker
PORT=8787
DATA_DIR=./data
NODE_ENV=development
API_TOKEN=replace-with-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:5173

# FUTEX
FUTEX_URL=https://futex.com.br/teste/
FUTEX_AUTOMATION_ENABLED=false
FUTEX_HEADLESS=true

# Limites de segurança: uma sessão por vez e intervalo mínimo entre solicitações.
MIN_SECONDS_BETWEEN_REQUESTS=30
MAX_ACTIVE_SESSIONS=1
