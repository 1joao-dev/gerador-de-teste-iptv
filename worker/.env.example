# Worker Playwright
PORT=8787
NODE_ENV=development
DATA_DIR=./data
# Em produção: gere com openssl rand -hex 32 e nunca troque com dados existentes
DATA_ENCRYPTION_KEY=
API_TOKEN=
# Keep these values stable; the owner name must match ADMIN_USERNAME on Vercel.
OWNER_USERNAME=1joaodev
# Optional dedicated pepper; if empty, API_TOKEN is used. Do not rotate while unused keys exist.
AUTH_KEY_PEPPER=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# FUTEX
FUTEX_URL=https://futex.com.br/teste/
FUTEX_AUTOMATION_ENABLED=false
FUTEX_HEADLESS=true

# Limites de segurança
MIN_SECONDS_BETWEEN_REQUESTS=30
MAX_ACTIVE_SESSIONS=1
MAX_SESSION_MINUTES=30
